{
  "implementation_model": {
    "name": "qwen3.6-27b-mtp",
    "base_url": "http://127.0.0.1:8163/v1",
    "api_key": "not-needed",
    "model": "local-gguf",
    "context_window": 131072,
    "max_tokens": 32768,
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "request_timeout_seconds": 21600,
    "retry_attempts": 20,
    "retry_sleep_seconds": 30,
    "request_heartbeat_seconds": 30
  },
  "feedback_model": null,
  "mcp_tools": {
    "terminal": true,
    "web_scraping": false,
    "web_interaction": true
  },
  "runtime": {
    "docker_isolation": true,
    "docker_image": "agentic-feedback-coding:local",
    "docker_user": "host",
    "workspace": "workspaces/qwen36-gpx-editor",
    "command_timeout_seconds": 0,
    "print_transcript": true,
    "live_turn_max_chars": 0,
    "color_transcript": true,
    "max_command_timeout_seconds": 21600,
    "final_summary": "compact",
    "feedback_response_max_tokens": 4096
  },
  "context_compaction": {
    "enabled": true,
    "threshold_ratio": 0.55,
    "keep_recent_turns": 6,
    "summary_max_tokens": 1024,
    "tool_output_max_chars": 4000,
    "workspace_file_max_bytes": 20000,
    "git_diff_max_chars": 20000,
    "transcript_review_max_chars": 24000
  },
  "loop": {
    "max_approach_reattempts": 5
  },
  "project_design": {
    "title": "GPX route editor with map-style track editing",
    "prompt": "Build a website that loads a GPX file by drag and drop or file picker. The main view should be an intuitive interactive map-style track editor taking most of the visible screen, with only a compact tools palette. It should support zooming, panning/moving, adding points at the end, inserting points in the middle, removing waypoints, and saving/exporting the edited GPX. Level 2: display length in kilometers and miles. Level 3: if real map surface data is not available without a key, use a deterministic local fallback that colors route segments by walking, road-bike, and mountain-bike suitability and summarizes risky/busy segment length. Validation must not require an external map API key. The implementation agent must create the project itself; do not rely on prewritten harness data. Choose independently verifiable implementation steps and write coherent vertical slices that can be reviewed with evidence."
  },
  "phases": {
    "requirements_refinement": {
      "max_iterations": 3
    },
    "plan_validation": {
      "max_iterations": 4
    },
    "implementation": {
      "max_iterations": 10
    }
  },
  "resolution_policy": {
    "max_same_error_repeats": 2,
    "allow_skip_with_note": true,
    "stop_on_cannot_resolve": false
  },
  "quality_policy": {
    "assume_code_quality_when_unspecified": true
  },
  "review_policy": {
    "hard_pushback_iterations": 3,
    "compromise_iterations": 4,
    "final_review_iterations": 1
  },
  "web_research": {
    "enabled": false,
    "max_search_results": 3,
    "max_pages": 3,
    "timeout_seconds": 15,
    "max_page_bytes": 1000000,
    "excerpt_chars": 3000,
    "user_agent": "agenticFeedbackCoding/0.1 (+local research harness)"
  },
  "git_policy": {
    "enabled": true,
    "commit_completed_steps": true,
    "require_step_diff": true,
    "leave_final_changes_uncommitted": false,
    "final_reset_mode": "soft",
    "commit_user_name": "agenticFeedbackCoding",
    "commit_user_email": "agentic-feedback@example.local"
  }
}
